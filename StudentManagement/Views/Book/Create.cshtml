@model BookInput
@{
    ViewData["Title"] = "Thêm sách";
}
<h1>Thêm sách</h1>
<form asp-controller="Book" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>
    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="any" />
    <span asp-validation-for="Price"></span>
    <button type="submit">Thêm sách</button>
</form>
<p><a asp-action="Index">Quay lại danh sách</a></p>
