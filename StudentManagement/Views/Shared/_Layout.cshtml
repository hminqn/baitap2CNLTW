<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Book Management</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f4f6fa; color: #182237; font: 16px/1.6 system-ui, sans-serif; }
        header { background: #182237; color: white; padding: 18px max(24px, calc((100% - 900px)/2)); }
        header strong { display: block; font-size: 22px; }
        nav { display: flex; gap: 24px; flex-wrap: wrap; }
        nav a { color: #dce7ff; }
        main { max-width: 900px; margin: 32px auto; padding: 28px; background: white; border-radius: 12px; }
        h1 { margin-top: 0; font-size: 28px; }
        a { color: #234dbc; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #dee3ec; }
        th { background: #f4f6fa; }
        form { max-width: 460px; }
        label { display: block; font-weight: 600; margin-top: 18px; }
        input { width: 100%; padding: 11px; border: 1px solid #aab4c5; border-radius: 6px; font: inherit; }
        button, .button { display: inline-block; background: #234dbc; color: white; border: 0; border-radius: 6px; padding: 10px 18px; font: inherit; cursor: pointer; text-decoration: none; margin-top: 20px; }
        .field-validation-error, .validation-summary-errors { color: #b42318; }
        .message { background: #edf4ff; padding: 12px 16px; border-radius: 6px; }
        .note { color: #566277; font-size: 14px; }
        dt { font-weight: 600; }
        dd { margin: 0 0 16px; }
        @@media (max-width: 600px) { main { margin: 16px; padding: 18px; } th, td { padding: 8px; } }
    </style>
</head>
<body>
    <header>
        <strong>Book Management</strong>
        <nav aria-label="Điều hướng chính">
            <a asp-controller="Book" asp-action="Index">Danh sách sách</a>
            <a asp-controller="Book" asp-action="Create">Thêm sách</a>
            <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </nav>
    </header>
    <main>@RenderBody()</main>
</body>
</html>
